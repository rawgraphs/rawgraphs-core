{
  "name": "@rawgraphs/rawgraphs-core",
  "version": "1.0.0-beta.17",
  "description": "RAWGRAPHS core library",
  "jsdelivr": "lib/index.umd.js",
  "unpkg": "lib/index.umd.js",
  "main": "lib/index.cjs.js",
  "module": "lib/index.es.js",
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!d3-|d3|internmap)"
    ]
  },
  "scripts": {
    "test": "jest",
    "test-coverage": "jest --coverage",
    "codecov": "jest --coverage && codecov",
    "prebuild": "rimraf lib",
    "build": "rollup -c",
    "buildwatch": "rollup -c -w",
    "nodebox": "NODE_ENV=test babel-node sandbox/node/index.js",
    "webbox": "webpack-dev-server",
    "generate-docs": "node_modules/.bin/jsdoc -c jsdoc.json",
    "doc2md": "jsdoc2md --no-cache -t doc.hbs src/* | tail -n +2 > website/docs/api.md"
  },
  "files": [
    "lib"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "babel-jest": "^30.4.1",
    "babel-loader": "^8.0.6",
    "css-loader": "^3.4.2",
    "dayjs": "^1.8.22",
    "docdash": "^1.2.0",
    "jest": "^30.4.2",
    "jsdoc": "^3.6.4",
    "jsdoc-to-markdown": "^6.0.1",
    "jsdom": "^16.2.0",
    "npm": "^6.14.5",
    "rimraf": "^3.0.2",
    "rollup": "^4.62.5",
    "style-loader": "^1.1.3",
    "webpack": "^4.41.6",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.10.3"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-color": "^3.1.0",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-svg-legend": "^2.25.6",
    "d3-time-format": "^4.1.0",
    "lodash": "^4.17.15"
  }
}
